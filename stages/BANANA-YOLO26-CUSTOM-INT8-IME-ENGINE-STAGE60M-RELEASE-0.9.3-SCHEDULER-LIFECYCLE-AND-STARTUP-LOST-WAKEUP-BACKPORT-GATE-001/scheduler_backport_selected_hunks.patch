diff --git a/custom_int8_engine/kernels/conv_threaded.cpp b/custom_int8_engine/kernels/conv_threaded.cpp
index 4ff467e..e6e2dae 100644
--- a/custom_int8_engine/kernels/conv_threaded.cpp
+++ b/custom_int8_engine/kernels/conv_threaded.cpp
@@ -400 +400,6 @@ void worker_loop(Y26ThreadedConvWorkspace* workspace, std::size_t worker_index)
-    workspace->ready_count.fetch_add(1, std::memory_order_release);
+    {
+        // Publish readiness while holding the condition-variable mutex so the
+        // creator cannot miss the transition between its predicate and wait.
+        std::lock_guard<std::mutex> lock(workspace->ready_mutex);
+        workspace->ready_count.fetch_add(1, std::memory_order_release);
+    }
